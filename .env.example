# ============================================================
# Kakebe Tech Camp — environment settings (copy to .env and fill in)
# The same file works on your computer and on the live server:
#   APP_ENV=auto → localhost / 127.0.0.1 / *.test use the LOCAL values,
#                  kakebetechcamp.com (and cron on the server) use the LIVE values.
#   Set APP_ENV=local or APP_ENV=production to force one.
# ============================================================
APP_ENV=auto
APP_URL_LIVE=https://kakebetechcamp.com
APP_KEY=
MAIL_OFFICIAL=info@kakebetechcamp.com

# ── Database: local (XAMPP) ──────────────────────────────────
DB_LOCAL_HOST=127.0.0.1
DB_LOCAL_PORT=3306
DB_LOCAL_NAME=kakebe_techcamp
DB_LOCAL_USER=root
DB_LOCAL_PASS=

# ── Database: live (kakebetechcamp.com) ──────────────────────
DB_LIVE_HOST=localhost
DB_LIVE_PORT=3306
DB_LIVE_NAME=
DB_LIVE_USER=
DB_LIVE_PASS=

# ── ioTec Pay (Kakebe Technologies account) ──────────────────
# Sandbox (test money) is only ever used in the LOCAL environment and only when true.
# The live site always uses the LIVE wallet.
IOTEC_SANDBOX=false
IOTEC_CLIENT_ID=
IOTEC_CLIENT_SECRET=
IOTEC_IPN_SECRET=
IOTEC_TEST_WALLET_ID=
IOTEC_LIVE_WALLET_ID=

# ── Email (used as defaults on a fresh database; Admin → Settings can override) ──
# SMTP_PASS is a Google App Password for SMTP_USER.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=kakebetech.comms@gmail.com
SMTP_PASS=
MAIL_FROM_NAME=Kakebe Tech Camp
MAIL_NOTIFY=info@kakebetechcamp.com, kakebetech.comms@gmail.com

# Optional: a bulk email service for Email campaigns (Admin → Marketing), e.g. Brevo, Mailgun, Amazon SES, ZeptoMail.
# Gmail allows only about 500 emails a day. Leave MK_SMTP_HOST empty to send campaigns through the SMTP account above.
MK_SMTP_HOST=
MK_SMTP_PORT=587
MK_SMTP_SECURE=tls
MK_SMTP_USER=
MK_SMTP_PASS=
MK_FROM_EMAIL=

# ── Google sign-in (Google Cloud → APIs & Services → Credentials → OAuth client) ──
# Authorised JavaScript origins must include http://localhost, https://kakebetechcamp.com and https://www.kakebetechcamp.com
GOOGLE_CLIENT_ID=256682755638-9hr2109773cbu3cd7iq78j8upuvtn5tv.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=

# Pesapal — card payments (registrations and sponsorships). Mobile Money stays on ioTec.
# Live keys are used on the live site; a local copy only ever uses the sandbox keys.
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_SANDBOX_CONSUMER_KEY=
PESAPAL_SANDBOX_CONSUMER_SECRET=

# Optional: path to an up-to-date CA bundle for outgoing HTTPS (only if PHP cannot verify certificates, e.g. local XAMPP)
CURL_CA_BUNDLE=
