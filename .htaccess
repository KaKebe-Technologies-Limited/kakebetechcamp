Options -Indexes
DirectoryIndex index.php

# One address for search engines: www.kakebetechcamp.com → kakebetechcamp.com (http → https is done by the host)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.kakebetechcamp\.com$ [NC]
  RewriteRule ^ https://kakebetechcamp.com%{REQUEST_URI} [R=301,L]

  # Short link for the Mentorship Program: /mentorship (old mentorship.php links redirect there)
  RewriteCond %{REQUEST_URI} ^(.*)/mentorship/$
  RewriteRule ^mentorship/$ %1/mentorship [R=301,L]
  RewriteCond %{REQUEST_METHOD} =GET
  RewriteCond %{THE_REQUEST} \s[^?\s]*/mentorship\.php[\s?]
  RewriteCond %{REQUEST_URI} ^(.*)/mentorship\.php$
  RewriteRule ^mentorship\.php$ %1/mentorship [R=301,L,QSA]
  RewriteRule ^mentorship$ mentorship.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Hide dotfiles, docs, SQL and logs
<FilesMatch "(^\.|\.(md|sql|log|ini|sh|bak)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/x-icon .ico
  AddType image/webp .webp
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType application/manifest+json "access plus 7 days"
  ExpiresByType application/xml "access plus 1 day"
  ExpiresByType text/plain "access plus 1 day"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript application/json application/manifest+json image/svg+xml image/x-icon
</IfModule>
